+/*
+ * VLC-PS5: HDR10 output. The framebuffers stay registered and are retyped in
+ * place (registering them again isn't possible while one is on screen); the
+ * new type applies from the next flip. The app waits for its GPU work to end
+ * first and from then on writes 10:10:10:2 PQ pixels into the same 32-bit
+ * buffers. 0 when VideoOut took it.
+ */
+int vlcps5_wsi_videoout_set_hdr(int enable);
+int vlcps5_wsi_videoout_dynamic_range(void);
+
+int
+vlcps5_wsi_videoout_set_hdr(int enable)
+{
+   struct wsi_videoout_output *out = &videoout_output;
+   mtx_lock(&out->lock);
+   int result = -1;
+   if (out->buffers) {
+      uint8_t attribute[PS5_VIDEO_OUT_ATTRIBUTE_BYTES] = {0};
+      sceVideoOutSetBufferAttribute2(attribute,
+                                     enable ? VLCPS5_VIDEO_OUT_PIXEL_FORMAT_HDR10
+                                            : PS5_VIDEO_OUT_PIXEL_FORMAT_B8G8R8A8_SDR,
+                                     PS5_VIDEO_OUT_TILING_64KB_R_X, VIDEOOUT_WIDTH, VIDEOOUT_HEIGHT, 0, 0, 0);
+      result = sceVideoOutSubmitChangeBufferAttribute2(out->handle, 0, attribute, NULL);
+   }
+   mtx_unlock(&out->lock);
+   fprintf(stderr, "wsi/videoout: framebuffers %s: 0x%08x\n", enable ? "HDR10" : "SDR", (unsigned)result);
+   return result;
+}
+
+/* VLC-PS5: what the output carries: 1 SDR, 2 HDR, 0 unknown, negative: no answer. */
+int
+vlcps5_wsi_videoout_dynamic_range(void)
+{
+   struct wsi_videoout_output *out = &videoout_output;
+   mtx_lock(&out->lock);
+   int result = -1;
+   if (videoout_open_locked()) {
+      struct ps5_video_out_output_status status;
+      memset(&status, 0, sizeof(status));
+      int rc = sceVideoOutGetOutputStatus(out->handle, &status);
+      result = rc == 0 ? (int)status.dynamic_range : -1;
+      fprintf(stderr, "wsi/videoout: output status 0x%08x: range %u, flags 0x%" PRIx64 "\n", (unsigned)rc,
+              status.dynamic_range, status.flags);
+   }
+   mtx_unlock(&out->lock);
+   return result;
+}
+
+/*
+ * VLC-PS5: the output's refresh for films, as VideoOut's output modes number
+ * it: 2 (23.976 Hz), 3 (24 Hz), 9 (50 Hz), 1 (back to the default). Asked
+ * first whether the output takes it; then the vblank period measured, in
+ * microseconds, into *period_us (0 if not changed). 0 when VideoOut took it.
+ */
+int vlcps5_wsi_videoout_set_refresh(int mode, int *period_us);
+
+int
+vlcps5_wsi_videoout_set_refresh(int mode, int *period_us)
+{
+   struct wsi_videoout_output *out = &videoout_output;
+   int result = -1;
+   if (period_us)
+      *period_us = 0;
+   mtx_lock(&out->lock);
+   if (videoout_open_locked()) {
+      const int supported = mode == (int)PS5_VIDEO_OUT_MODE_RESTORE
+                               ? 1
+                               : sceVideoOutIsOutputSupported(out->handle, (uint32_t)mode, NULL, NULL, NULL);
+      result = supported > 0 ? sceVideoOutConfigureOutput(out->handle, (uint32_t)mode, NULL, NULL, NULL)
+                             : (supported < 0 ? supported : -2);
+      int measured = 0;
+      if (result == 0)
+         measured = (int)(videoout_vblank_period_ns(out->handle) / 1000);
+      if (period_us)
+         *period_us = measured;
+      fprintf(stderr, "wsi/videoout: output mode %d: %s (0x%08x), a vblank every %.3f ms\n", mode,
+              result == 0 ? "taken" : supported > 0 ? "refused" : "not supported", (unsigned)result,
+              measured / 1000.0);
+   }
+   mtx_unlock(&out->lock);
+   return result;
+}
