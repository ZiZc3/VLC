+/* PS5: FreeBSD 11's libc has neither strerror_l nor message locales.
+ * strerror_r into a per-thread buffer keeps the "valid until the next call
+ * in the same thread" promise below. */
+static const char *vlc_strerror_l(int errnum, const char *lname)
+{
+    static __thread char buf[128];
+    (void) lname;
+    if (strerror_r(errnum, buf, sizeof (buf)) != 0)
+        return "Error message unavailable";
+    return buf;
+}
