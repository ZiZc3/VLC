--- a/src/misc/picture.c
+++ b/src/misc/picture.c
@@ -62,9 +62,17 @@
 /**
  * Destroys a picture allocated with picture_NewFromFormat().
  */
+/* VLC-PS5: a 4K picture is 25 MiB and a video keeps 20 to 30 of them,
+ * more than the console's heap holds; the title puts big ones in its
+ * direct memory. Weak: without them, the heap as before. */
+extern void *vlc_ps5_big_alloc( size_t ) __attribute__((weak));
+extern int vlc_ps5_big_free( void * ) __attribute__((weak));
+#define VLC_PS5_BIG_PICTURE (4 << 20)
+
 static void picture_Destroy( picture_t *p_picture )
 {
-    aligned_free( p_picture->p[0].p_pixels );
+    if( vlc_ps5_big_free == NULL || !vlc_ps5_big_free( p_picture->p[0].p_pixels ) )
+        aligned_free( p_picture->p[0].p_pixels );
     free( p_picture );
 }
 
@@ -274,7 +282,11 @@
         goto error;
 
     pic_size = (pic_size + 63) & ~63; /* must be a multiple of 64 */
-    uint8_t *buf = aligned_alloc(64, pic_size);
+    uint8_t *buf = NULL;
+    if (vlc_ps5_big_alloc != NULL && pic_size >= VLC_PS5_BIG_PICTURE)
+        buf = vlc_ps5_big_alloc(pic_size);
+    if (buf == NULL)
+        buf = aligned_alloc(64, pic_size);
     if (buf == NULL)
         goto error;
 
