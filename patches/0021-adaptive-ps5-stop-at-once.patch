@@ -42,6 +42,19 @@
 
 using namespace adaptive::http;
 
+/* VLC-PS5: the player stopped this video (src/player.cc). Without this,
+ * after a stop the next segment was still fetched, by VLC's own http once
+ * the console's refused it, and leaving a slow channel took 10 s; the next
+ * video waited for it (2026-10-18). */
+extern "C" int vlc_ps5_stream_cancelled(long) __attribute__((weak));
+static bool ps5_cancelled(vlc_object_t *obj)
+{
+    if (vlc_ps5_stream_cancelled == nullptr)
+        return false;
+    long serial = (long)var_InheritInteger(obj, "ps5http-serial");
+    return serial > 0 && vlc_ps5_stream_cancelled(serial);
+}
+
 AbstractConnection::AbstractConnection(vlc_object_t *p_object_)
 {
     p_object = p_object_;
@@ -295,7 +308,7 @@
